# Mimamori Companion AI Service Configuration
# Copy to .env for local development. Never commit .env or real API keys.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO

# Embeddings: "hash_dev" (fast offline deterministic CPU default) or "huggingface_e5"
EMBEDDING_PROVIDER=hash_dev
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# ChromaDB PersistentClient storage path (kept outside repo by default)
CHROMA_PERSIST_DIR=E:\mimamori_artifacts\chroma
CHROMA_COLLECTION_NAME=mimamori_companion_knowledge
RAG_TOP_K=3
RAG_MIN_SIMILARITY_SCORE=0.25

# Model Provider: "mock" (offline dev/tests), "openai_compatible", or "transformers_local"
MODEL_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_NAME=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_TOKENS=320
LLM_TEMPERATURE=0.3

# Optional local HuggingFace / PEFT LoRA adapter hook (Qwen/Qwen3-4B-Instruct-2507)
BASE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=
