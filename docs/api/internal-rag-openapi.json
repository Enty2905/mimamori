              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,79}$",
              "title": "Source Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionResult"
                }
              }
            }
          },
          "401": {
            "content": {
